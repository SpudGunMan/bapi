BAPP=4
ID=RAGTIME
Name=Ragtime
Comment='Amateur radio chat terminal for data2g modem'
VerLocal=0
VerRemote=0
W3='https://github.com/baitisj/ragtime'
Author='spud'
NOTE=''

INSTALL(){
    # Install dependencies
    sudo apt-get install -y build-essential cmake pkg-config libwxgtk3.2-dev libgtk-3-dev \
        libhamlib-dev libpipewire-0.3-dev libopenjp2-7-dev libwebp-dev libheif-dev \
        libheif-plugin-libde265 git || return

    cd ${BAPSRC} || return
    rm -rf ragtime
    git clone https://github.com/baitisj/ragtime || return
    cd ragtime || return
    
    # Build with cmake
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release || return
    cmake --build build -j$(nproc) || return
    

}

VERSION(){
    if [ -f /usr/local/bin/ragtime ];then
        CURRENT="installed"
    else
        CURRENT="not installed"
    fi
    NEWVER=git
}

DEPENDS(){
    NEEDED='DATA2G'

    #apt-gets will be checked on app-check
}
