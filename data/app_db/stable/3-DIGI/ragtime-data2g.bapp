BAPP=4
ID=RAGTIME
Name=Ragtime
Comment='Amateur radio chat terminal for data2g modem'
VerLocal=0
VerRemote=0
W3='https://github.com/baitisj/ragtime'
Author='spud'
NOTE=''

INSTALL(){
    # Install dependencies
    sudo apt-get install -y libwxgtk3.2-dev libgtk-3-dev \
        libpipewire-0.3-dev libopenjp2-7-dev libwebp-dev libheif-dev \
        libheif-plugin-libde265 git make cmake build-essential || return

    # Build and install sotto first
    cd ${BAPSRC} || return
    rm -rf sotto
    git clone https://github.com/baitisj/sotto.git || return
    cd sotto || return
    make || return
    sudo make install || return
    sudo ldconfig || return

    cd ${BAPSRC} || return
    rm -rf ragtime
    git clone https://github.com/baitisj/ragtime || return
    cd ragtime || return
    
    # Build with cmake
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release || return
    cmake --build build -j$(nproc) || return
    
    # Copy binary to source root
    cp build/app/ragtime ~/

}

VERSION(){
    if [ -f ${BAPSRC}/ragtime ];then
        CURRENT="installed"
    else
        CURRENT=""
    fi
    NEWVER=git
}

DEPENDS(){
    NEEDED=''

    #apt-gets will be checked on app-check
}
