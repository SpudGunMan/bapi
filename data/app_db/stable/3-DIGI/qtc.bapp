BAPP=4
ID=QTC
Name=QtC
Comment='Multi-mode BBS mail client for LinBPQ'
VerLocal=0
VerRemote=0
W3='https://github.com/Bill-Johnson/QtC'
Author='spud'
NOTE='Python3 + PyQt6 app. VARA HF/FM can run via Wine on Linux/Pi.'

INSTALL(){
	echo -e "INFORMATIONAL: apt-get required packages"
	sudo apt-get -y install python3 python3-pip python3-pyqt6 python3-pyserial >> errors/apt.log

	cd "${BAPSRC}" || return
	rm -rf qtc
	mkdir -p qtc
	cd qtc || return

	QTC_RELEASE_JSON=$(curl --max-time 20 -s https://api.github.com/repos/Bill-Johnson/QtC/releases/latest)
	QTC_TAG=$(echo "$QTC_RELEASE_JSON" | grep -m 1 '"tag_name"' | cut -d '"' -f4)
	QTC_ASSET_URL=$(echo "$QTC_RELEASE_JSON" | grep '"browser_download_url"' | grep -m 1 'QtC-.*\.tar\.gz' | cut -d '"' -f4)

	if [ -z "$QTC_TAG" ]; then
		QTC_TAG=$(curl --max-time 20 -s https://api.github.com/repos/Bill-Johnson/QtC/tags?per_page=20 | grep -m 1 '"name"' | cut -d '"' -f4)
	fi

	if [ -z "$QTC_TAG" ]; then
		QTC_LATEST_URL=$(curl --max-time 20 -sL -o /dev/null -w '%{url_effective}' https://github.com/Bill-Johnson/QtC/releases/latest)
		QTC_TAG=$(echo "$QTC_LATEST_URL" | sed -n 's#.*/tag/\([^/?]*\).*#\1#p')
	fi

	if [ -z "$QTC_TAG" ]; then
		echo "ERROR: Unable to determine QtC latest release tag."
		return 1
	fi

	if [ -z "$QTC_ASSET_URL" ]; then
		QTC_ASSET_URL="https://github.com/Bill-Johnson/QtC/archive/refs/tags/${QTC_TAG}.tar.gz"
	fi

	wget --tries 2 --connect-timeout=60 -O qtc.tar.gz "$QTC_ASSET_URL"
	tar -xzf qtc.tar.gz
	rm -f qtc.tar.gz

	QTC_DIR=$(find . -maxdepth 1 -type d -name 'QtC*' | head -n 1)
	if [ -z "$QTC_DIR" ]; then
		echo "ERROR: QtC archive extract failed."
		return 1
	fi

	cd "$QTC_DIR" || return
	chmod +x install.sh uninstall.sh
	./install.sh

}

VERSION(){
	if command -v qtc >/dev/null 2>&1; then
		if [ -f "${HOME}/.local/share/qtc/main_window.py" ]; then
			CURRENT=$(head -n 1 "${HOME}/.local/share/qtc/main_window.py" | grep -Eo 'v[0-9][^ ]*' | head -n 1)
			if [ -z "$CURRENT" ]; then
				CURRENT=INSTALLED
			fi
		else
			CURRENT=INSTALLED
		fi
	else
		CURRENT=NONE
	fi

	NEWVER=$(curl --max-time 20 -s https://api.github.com/repos/Bill-Johnson/QtC/releases/latest | grep -m 1 '"tag_name"' | cut -d '"' -f4)
	if [ -z "$NEWVER" ]; then
		NEWVER=NONE
	fi
	if [ -z "$NEWVER" ]; then
		NEWVER=NONE
	if [ -z "$NEWVER" ]; then
		NEWVER=NONE
	fi
}

DEPENDS(){
	NEEDED=''

	#apt-gets will be checked on app-check
}