BAPP=4
ID=QTC
Name=QtC
Comment='Multi-mode BBS mail client for LinBPQ'
VerLocal=0
VerRemote=0
W3='https://github.com/Bill-Johnson/QtC'
Author='spud'
NOTE='Source-only install. Uses a dedicated venv for the selected GitHub branch. VARA HF/FM can run via Wine on Linux/Pi.'

INSTALL(){
	echo -e "INFORMATIONAL: apt-get required packages"
	sudo apt-get -y install git python3 python3-pip python3-venv >> errors/apt.log

	cd "${BAPSRC}" || return
	rm -rf qtc
	mkdir -p qtc
	cd qtc || return

	QTC_REPO="https://github.com/Bill-Johnson/QtC.git"
	QTC_BRANCH="main"
	if command -v yad >/dev/null 2>&1; then
		QTC_BRANCHES=$(git ls-remote --heads "$QTC_REPO" | sed 's#.*refs/heads/##' | sed '/^$/d' | sort)
		if [ -n "$QTC_BRANCHES" ]; then
			YAD_ARGS=(
				--title="QtC source branch"
				--list --radiolist
				--column="Sel" --column="Key" --column="Choice"
			)
			for BRANCH in $QTC_BRANCHES; do
				if [ "$BRANCH" = "main" ]; then
					YAD_ARGS+=(TRUE "$BRANCH" "Main branch ($BRANCH)")
				else
					YAD_ARGS+=(FALSE "$BRANCH" "Branch $BRANCH")
				fi
			done
			CHOICE_RAW=$(yad "${YAD_ARGS[@]}" --print-column=2 --hide-column=2 --center --width=760 --height=420 2>/dev/null)
			CHOICE=$(echo "$CHOICE_RAW" | tr -d '\r' | sed 's/[[:space:]]*$//')
			if [ -n "$CHOICE" ]; then
				QTC_BRANCH="$CHOICE"
			fi
		fi
	fi

	if [ -z "$QTC_BRANCH" ]; then
		QTC_BRANCH="main"
	fi

	echo "INFORMATIONAL: cloning QtC branch ${QTC_BRANCH}"
	git clone --depth 1 --branch "$QTC_BRANCH" --single-branch "$QTC_REPO" QtC || return 1
	QTC_DIR="QtC"
	if ! git -C "$QTC_DIR" rev-parse --abbrev-ref HEAD >/dev/null 2>&1; then
		echo "ERROR: clone completed but branch was not checked out."
		return 1
	fi
	SELECTED_HEAD=$(git -C "$QTC_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || true)
	if [ "$SELECTED_HEAD" != "$QTC_BRANCH" ]; then
		git -C "$QTC_DIR" checkout -q "$QTC_BRANCH" || return 1
	fi
	if [ -n "$SELECTED_HEAD" ]; then
		echo "INFORMATIONAL: selected branch is $SELECTED_HEAD"
	fi
	QTC_INSTALL_DIR="${HOME}/.local/share/qtc"
	QTC_VENV="${QTC_INSTALL_DIR}/.venv"

	rm -rf "$QTC_INSTALL_DIR"
	mkdir -p "$QTC_INSTALL_DIR"
	cp -a "$QTC_DIR"/. "$QTC_INSTALL_DIR/" || return 1

	python3 -m venv "$QTC_VENV" || return 1
	"${QTC_VENV}/bin/pip" install --upgrade pip setuptools wheel || return 1

	if [ -f "${QTC_INSTALL_DIR}/requirements.txt" ]; then
		"${QTC_VENV}/bin/pip" install -r "${QTC_INSTALL_DIR}/requirements.txt" || return 1
	fi
	"${QTC_VENV}/bin/pip" install PyQt6 pyserial || return 1

	mkdir -p "${HOME}/.local/bin"
	cat > "${HOME}/.local/bin/qtc" << EOF
#!/usr/bin/env bash
cd "${QTC_INSTALL_DIR}"
exec "${QTC_VENV}/bin/python" "${QTC_INSTALL_DIR}/main_window.py" "\$@"
EOF
	chmod +x "${HOME}/.local/bin/qtc"
	chmod +x "${QTC_INSTALL_DIR}/install.sh" "${QTC_INSTALL_DIR}/uninstall.sh" 2>/dev/null || true
	printf '%s\n' "$QTC_BRANCH" > "${HOME}/.bap.qtc.ver"
}

VERSION(){
	if command -v qtc >/dev/null 2>&1; then
		if [ -f "${HOME}/.bap.qtc.ver" ]; then
			CURRENT=$(cat "${HOME}/.bap.qtc.ver")
		elif [ -f "${HOME}/.local/share/qtc/main_window.py" ]; then
			CURRENT=$(head -n 1 "${HOME}/.local/share/qtc/main_window.py" | grep -Eo 'v[0-9][^ ]*' | head -n 1)
			if [ -z "$CURRENT" ]; then
				CURRENT=INSTALLED
			fi
		else
			CURRENT=INSTALLED
		fi
	else
		CURRENT=NONE
	fi

	if [ -f "${HOME}/.bap.qtc.ver" ]; then
		NEWVER=$(cat "${HOME}/.bap.qtc.ver")
	else
		NEWVER=UNKNOWN
	fi
}

DEPENDS(){
	NEEDED=''

	#apt-gets will be checked on app-check
}
