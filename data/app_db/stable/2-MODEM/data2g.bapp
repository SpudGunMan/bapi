BAPP=4
ID=DATA2G
Name=DATA2G
Comment='data2g modem'
VerLocal=0
VerRemote=0
W3='https://github.com/arodland/Data2G/'
Author='spud'
NOTE='DATA2G project'

INSTALL(){

    cd "${BAPSRC}" || return
    rm -rf data2g Data2G
    rm -f data2g.tar.gz

    # Determine architecture
    if [[ $(uname -m) == 'aarch64' ]]; then
        ARCH="aarch64"
    else
        ARCH="x86_64"
    fi

    # Get the latest upstream GitHub release tag dynamically
    VERSION=$(curl --max-time 20 -fsSL https://api.github.com/repos/arodland/Data2G/releases/latest | python3 -c 'import sys, json; data=json.load(sys.stdin); print(data.get("tag_name", "").lstrip("v"))') || return
    if [ -z "$VERSION" ]; then
        echo "Unable to determine latest Data2G release" >&2
        return 1
    fi

    echo "Latest Data2G release: v${VERSION}"

    if command -v yad >/dev/null 2>&1; then
        BUILD_MODE=$(yad --title="Data2G install method" --center --width=420 --height=180 --list \
            --radiolist --column="Select" --column="Method" \
            TRUE "binary" FALSE "source" \
            --print-column=2 --separator="" 2>/dev/null) || return
        if [ -z "$BUILD_MODE" ]; then
            echo "Installation cancelled"
            return 1
        fi
    else
        echo "Choose an install method:"
        echo "  1) Download the upstream binary release"
        echo "  2) Build from source (use this for Qt 6.x compatibility issues)"
        read -p "Select 1 or 2 [1]: " -r BUILD_MODE
        BUILD_MODE=${BUILD_MODE:-1}
    fi

    if [[ "$BUILD_MODE" == "source" || "$BUILD_MODE" == "2" ]]; then
        echo -e "INFORMATIONAL: installing Data2G build dependencies"
        sudo apt-get -y install git build-essential cmake ninja-build pkg-config zlib1g-dev python3 python3-dev python3-pip python3-venv pybind11-dev qt6-base-dev qt6-multimedia-dev qt6-websockets-dev qt6-tools-dev libqt6dbus6 libhamlib-dev >> errors/apt.log || return

        git clone --depth 1 --branch "v${VERSION}" https://github.com/arodland/Data2G.git "${BAPSRC}/Data2G" || return
        cd "${BAPSRC}/Data2G" || return

        VENV_DIR="${BAPSRC}/Data2G/.venv"
        if [ ! -d "$VENV_DIR" ]; then
            python3 -m venv "$VENV_DIR" || return
        fi
        . "$VENV_DIR/bin/activate"

        python -m pip install --upgrade pip setuptools wheel uv || return
        python -m pip install pybind11 || return

        cmake -S native -B native/build -G Ninja -DCMAKE_BUILD_TYPE=Release || return
        cmake --build native/build --parallel || return
        sudo cmake --install native/build || return
        return
    fi

    FILENAME="data2g-${VERSION}-linux-${ARCH}.tar.gz"
    URL="https://github.com/arodland/Data2G/releases/download/v${VERSION}/${FILENAME}"

    wget "$URL" -O data2g.tar.gz || return
    tar xzf data2g.tar.gz || return

    if [ -d "${HOME}/data2g" ]; then
        rm -rf "${HOME}/data2g"
    fi
    mv data2g "${HOME}/" || return

}

VERSION(){
    if [ -f /usr/local/bin/data2g-host ] || [ -f /usr/local/bin/data2g-gui ];then
        CURRENT="installed"
    else
        CURRENT=""
    fi
    NEWVER=$(curl --max-time 20 -fsSL https://api.github.com/repos/arodland/Data2G/releases/latest | python3 -c 'import sys, json; data=json.load(sys.stdin); print(data.get("tag_name", "").lstrip("v"))') || NEWVER="unknown"
}

DEPENDS(){
    NEEDED='HAMLIB'
    #apt-gets will be checked on app-check
}
