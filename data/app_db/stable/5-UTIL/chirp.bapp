BAPP=4
ID=CHIRP
Name=CHIRP
Comment='Chirp Radio Programmer'
VerLocal=0
VerRemote=0
W3=''
Author='spud'
NOTE='this will also delay menu load because chirp -version is slow'

INSTALL(){
    echo -e "INFORMATIONAL: apt-get required packages"
    sudo apt-get -y install python3-pip >> errors/apt.log
    sudo apt-get -y install python-wxtools 2>&1 >> errors/apt.log

    cd ${BAPSRC}
    mkdir chirp
    cd chirp
    CHIRPDATE=$(curl --max-time 20 -fsSL https://archive.chirpmyradio.com/chirp_next/ | grep -Eo 'next-[0-9]{8}/' | sed 's|next-||;s|/||' | sort -r | head -1)
    if [[ -z "$CHIRPDATE" ]]; then
        CHIRPDATE=20261002
    fi
    

    if [[ "$BAPCPU" == "x86_64" ]]; then
        APPIMG=$(curl --max-time 20 -fsSL "https://archive.chirpmyradio.com/chirp_next/next-${CHIRPDATE}/" | grep -Eo 'Chirp-next-[0-9]{8}-x86_64\.AppImage' | head -1)
        if [[ -z "$APPIMG" ]]; then
            APPIMG=Chirp-next-${CHIRPDATE}-x86_64.AppImage
        fi
        LINK=https://archive.chirpmyradio.com/chirp_next/next-${CHIRPDATE}/${APPIMG}
        echo -e "Downloading Chirp AppImage"
        wget --tries 2 --connect-timeout=60 "$LINK"
        if [[ -f "$APPIMG" ]]; then
            echo -e "Installing Chirp AppImage"
            chmod +x "$APPIMG"
            sudo mv "$APPIMG" /usr/local/bin/
            sudo ln -fs "/usr/local/bin/$APPIMG" /usr/local/bin/chirp
        else
            echo -e "ERROR: Chirp AppImage failed to download"
        fi
    else
        WHEEL=$(curl --max-time 20 -fsSL "https://archive.chirpmyradio.com/chirp_next/next-${CHIRPDATE}/" | grep -Eo 'chirp-[0-9]{8}-py3-none-any\.whl' | head -1)
        if [[ -z "$WHEEL" ]]; then
            WHEEL=chirp-${CHIRPDATE}-py3-none-any.whl
        fi
        LINK=https://archive.chirpmyradio.com/chirp_next/next-${CHIRPDATE}/${WHEEL}
        echo -e "Downloading Chirp wheel"
        wget --tries 2 --connect-timeout=60 "$LINK"
        if [[ -f "$WHEEL" ]];then
            echo -e "Installing Chirp wheel"
            pip3 install "$WHEEL" --break-system-packages
            rm "$WHEEL"
        else
            echo -e "ERROR: Chirp wheel failed to download"
        fi
    fi

}

VERSION(){
    if [[ $(whereis chirp | grep bin) ]];then
		CURRENT=0-git
        #$(chirp --version | awk '{ print $2 }' | sed 's/daily-//')
    else
        CURRENT=NONE
    fi
    NEWVER=$(curl --max-time 20 -fsSL https://archive.chirpmyradio.com/chirp_next/ | grep -Eo 'next-[0-9]{8}/' | sed 's|next-||;s|/||' | sort -r | head -1)
    if [[ -z "$NEWVER" ]]; then NEWVER=20261002; fi
}

DEPENDS(){
    NEEDED=''
    #apt-gets will be checked on app-check
}
