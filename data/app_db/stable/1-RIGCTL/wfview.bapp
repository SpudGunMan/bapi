BAPP=4
ID=WFVIEW
Name=wfview
Comment='wfview (Qt6 build from source)'
VerLocal=0
VerRemote=0
W3='https://wfview.org'
Author='spud'
NOTE='Builds from the upstream GitHub repo using Qt 6.'

INSTALL(){
    echo -e "INFORMATIONAL: installing required packages for wfview v3/Qt 6"
    sudo apt-get update >> errors/apt.log 2>&1 || true

    sudo apt-get -y install build-essential git pkg-config ca-certificates \
        qmake6 qt6-base-dev qt6-base-dev-tools qt6-declarative-dev \
        qt6-serialport-dev qt6-multimedia-dev qt6-websockets-dev \
        qml6-module-qtqml qml6-module-qtqml-models qml6-module-qtqml-workerscript \
        qml6-module-qtquick qml6-module-qtquick-controls qml6-module-qtquick-templates \
        qml6-module-qtquick-layouts qml6-module-qtquick-window qml6-module-qtquick-dialogs \
        qt6-qpa-plugins libgl-dev libopengl-dev libopus-dev libeigen3-dev \
        portaudio19-dev librtaudio-dev libpulse-dev libhidapi-dev libudev-dev \
        libqt6svg6 >> errors/apt.log 2>&1 || true

    cd ${BAPSRC} || return
    rm -rf wfview
    git clone --depth 1 --recurse-submodules --shallow-submodules -b main https://github.com/wf-group/wfview.git
    cd wfview || return
    mkdir -p build
    cd build || return

    if command -v qmake6 >/dev/null 2>&1; then
        qmake6 ../wfview.pro
    else
        qmake ../wfview.pro
    fi

    make -j$BAPCORE
    if [ $? -ne 0 ]; then
        echo "Error in make step."
        echo "wfview was not compiled."
        echo "Please consider posting the error(s) to https://forum.wfview.org/"
        exit -1
    fi

    sudo make install
}

VERSION(){
    if command -v wfview >/dev/null 2>&1; then
        CURRENT=$(wfview -v 2>/dev/null | tr -d '\r' | grep -Eo '[0-9]+([.][0-9]+)+' | head -n1)
        if [ -z "$CURRENT" ]; then
            CURRENT=NONE
        fi
    else
        CURRENT=NONE
    fi

    NEWVER=$(curl --max-time 20 -s https://raw.githubusercontent.com/wf-group/wfview/main/wfview.pro | tr -d '\r' | grep -E 'WFVIEW_VERSION=' | head -n1 | sed -E 's/.*WFVIEW_VERSION="?([^"[:space:]]+).*/\1/')
    if [ -z "$NEWVER" ]; then
        NEWVER=NONE
    fi
}

DEPENDS(){
    NEEDED=''

    #apt-gets will be checked on app-check
}
